.dishphoto_arrange{
    display: flex;
    flex-direction: column;
    gap: 30px;
    align-items: center;
}

.dishphoto_arrange img{
    width: 1100px;
    height: 200px;
    object-fit: cover;
}

#button1{
    width: 100px;
    height: 45px;
    font-size: 20px;
    margin-top: 5px;
    margin-bottom: 70px;
    margin-right: 20px;
    background-color: grey;
    color:white;
    border: none;
    border-radius: 15px;
}
.loginbutton{
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    text-decoration: none;
}

.login-popup-window{
    display: none;
}

#searchbox{
    width: 100%;
    display:flex;
    flex-direction: row;
    justify-content: center;
}

#searchbox input{
    width: 450px;
    height: 35px;
    border-radius: 20px;
    border-width: 3px;
    border-color: grey;
}

.titleline{
    display: flex;
    flex-direction: row;
}